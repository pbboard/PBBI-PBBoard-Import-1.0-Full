<template name="import_step.tpl" type="new">
<text><![CDATA[
<div class="address_bar">{$lang['import_system']} &raquo; {$lang['processing']}</div>

<div class="t_style_b" style="padding: 20px; text-align: center;">
    <h3 id="import-status">جاري تحضير عملية الاستيراد...</h3>

    <div style="width: 100%; background: #eee; border-radius: 5px; margin: 20px 0; height: 25px; position: relative; overflow: hidden;">
        <div id="progress-bar" style="width: 0%; background: #2ecc71; height: 100%; transition: width 0.3s;"></div>
    </div>

<div id="import-details" style="font-size: 14px; color: #333; font-weight: bold; margin-top: 10px;">
    جاري استيراد: <span id="current-step" style="color: #e67e22;">---</span> |
    تم نقل <span id="processed-count" style="color: #27ae60;">0</span> سجل بنجاح
</div>
</div>

<script>
// نستخدم jQuery لضمان التوافق مع بيئة PBBoard
jQuery(document).ready(function($) {
    const importSteps = {$js_steps};
    let currentStepIndex = 0;
    let offset = 0;
    const limit = {$selected_limit};

    function processNext() {
        // 1. التحقق من انتهاء جميع المراحل المختارة
        if (currentStepIndex >= importSteps.length) {
            // إخفاء تفاصيل العدادات الصغيرة لتركيز الانتباه على رسالة النجاح
            $('#import-details').fadeOut();

            // صياغة رسالة النجاح النهائية مع التنويه المطلوب
let finalMsg = `
                <div style="margin-top: 20px; padding: 25px; border: 1px solid #2ecc71; background: #f0fff4; border-radius: 8px; text-align: right; direction: rtl; font-family: tahoma;">
                    <h2 style="color: #27ae60; margin-bottom: 10px; text-align: center;">✔ تم اكتمال الاستيراد بنجاح!</h2>
                    <hr style="border: 0; border-top: 1px solid #d4edda; margin: 15px 0;">

                    <div style="color: #155724; font-size: 14px; line-height: 1.8;">
                        <strong style="color: #c0392b; font-size: 16px;">الخطوات النهائية المطلوبة:</strong>

                        <ul style="margin-top: 10px; list-style-type: none; padding-right: 0;">
                            <li style="margin-bottom: 15px;">
                                <b>1. يجب تحديث جميع العدادات:</b><br>
                                لضمان ظهور البيانات بشكل صحيح، يجب التوجه إلى:
                                <b style="padding: 3px 8px; background: #fff; border: 1px dashed #2ecc71; font-weight: bold;">
                                    الصيانة &raquo; تحديث العدادات
                                </b>
                            </li>

                            {if {$Configuretitleimport} == 'XenForo2'}
                            <li style="margin-bottom: 10px; padding: 12px; background: #fff5f5; border: 1px solid #feb2b2; border-radius: 6px; color: #c53030;">
                                <strong>⚠️ تنبيه أمني (XenForo 2):</strong><br>
                                بسبب اختلاف نظام تشفير كلمات المرور، لن يتمكن الأعضاء من الدخول بكلماتهم القديمة.
                                <b>يجب على الجميع (بما فيهم المدير) استخدام رابط "فقدت كلمة المرور" لتعيين كلمة سر جديدة.</b>
                            </li>
                            {/if}
                        </ul>
                    </div>

                    <div style="margin-top: 20px; text-align: center;">
                        <a href="index.php" style="background: #2ecc71; color: white; padding: 10px 30px; text-decoration: none; border-radius: 4px; font-weight: bold; display: inline-block;">العودة للوحة الإدارة</a>
                    </div>
                </div>
            `;

            $('#import-status').html(finalMsg);
            $('#current-step').text('---');
            return;
        }

        let currentStep = importSteps[currentStepIndex];
        $('#current-step').text(currentStep);
        $('#import-status').html('جاري معالجة قسم: <span style="color:#2980b9;">' + currentStep + '</span>');

        // 2. تنفيذ طلب AJAX عبر jQuery
        $.ajax({
            url: 'index.php?page=importer&import=1&ajax=1',
            type: 'POST',
            data: {
                action: 'process',
                step: currentStep,
                offset: offset,
                limit: limit
            },
            dataType: 'json',
            success: function(data) {
                if (data.status === 'continue') {
                    // لم ننتهي من هذا القسم بعد (يوجد سجلات إضافية)
                    offset += limit;
                    updateUI(data.percent, data.total_processed);
                    processNext();
                }
                else if (data.status === 'step_complete') {
                    // انتهينا من هذا القسم، ننتقل للقسم التالي في المصفوفة
                    offset = 0;
                    currentStepIndex++;
                    updateUI(100, data.total_processed);

                    // تأخير بسيط (نصف ثانية) لراحة العين قبل الانتقال للخطوة التالية
                    setTimeout(processNext, 100);
                }
                else if (data.status === 'error') {
                    $('#import-status').html('<b style="color:red;">خطأ: ' + data.message + '</b>');
                }
            },
            error: function(xhr, status, error) {
                $('#import-status').html('<b style="color:red;">حدث خطأ في الاتصال بالسيرفر!</b>');
                console.error("AJAX Error:", status, error);
            }
        });
    }

    function updateUI(percent, count) {
        $('#progress-bar').css('width', percent + '%');
        $('#processed-count').text(count);
    }

    // بدء المعالجة الفعلية
    processNext();
});
</script>
]]></text>
</template>
